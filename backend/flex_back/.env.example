# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
WORKERS=1

# Server Settings
HOST=localhost
PORT=8080

# MongoDB Settings
MONGODB_URL="mongodb+srv://user:password@cluster.mongodb.net/db?retryWrites=true&w=majority"
MONGODB_DATABASE="flex_living"

# Authentication & Security
JWT_SECRET="your_jwt_secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY="your_encryption_key"

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# External Integrations
GROQ_API_KEY="your_groq_api_key"
HOSTAWAY_API_KEY="your_hostaway_api_key"
HOSTAWAY_ACCOUNT_ID="your_hostaway_account_id"
HOSTAWAY_BASE_URL="https://api.hostaway.com/v1"

# Feature Flags
DEBUG_EMAIL_TESTING=True
ENABLE_AI_ANALYSIS=True
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_RATE_LIMITING=True
ENABLE_CORS=True
ENABLE_HOSTAWAY_INTEGRATION=True
ENABLE_GOOGLE_PLACES_INTEGRATION=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Email Configuration (SendGrid)
SENDGRID_API_KEY="your_sendgrid_api_key"
FROM_EMAIL="your_from_email"
FROM_NAME="Flex Living"

# Frontend & CORS Settings
FRONTEND_URL="http://localhost:3000"
TEST_EMAIL="test@example.com"
