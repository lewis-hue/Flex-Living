import time
import statistics
from concurrent.futures import ThreadPoolExecutor

class PerformanceTester:
    def __init__(self, base_url: str, ws_url: str):
        self.base_url = base_url
        self.ws_url = ws_url
        self.results = {}
    
    async def test_api_performance(self, concurrent_users: int = 100, duration: int = 60):
        """Test API performance under load"""
        print(f"Testing API performance: {concurrent_users} users for {duration}s")
        
        start_time = time.time()
        end_time = start_time + duration
        
        # Create concurrent sessions
        async def user_session(session_id: int):
            response_times = []
            request_count = 0
            
            async with aiohttp.ClientSession() as session:
                while time.time() < end_time:
                    try:
                        # Test analytics endpoint
                        request_start = time.time()
                        async with session.get(f"{self.base_url}/api/v1/analytics/overview") as response:
                            await response.json()
                            request_time = time.time() - request_start
                            response_times.append(request_time)
                            request_count += 1
                            
                    except Exception as e:
                        print(f"Session {session_id} error: {e}")
                    
                    # Random delay between requests
                    await asyncio.sleep(random.uniform(0.1, 0.5))
            
            return {
                'session_id': session_id,
                'response_times': response_times,
                'request_count': request_count
            }
        
        # Run concurrent sessions
        tasks = [user_session(i) for i in range(concurrent_users)]
        results = await asyncio.gather(*tasks)
        
        # Analyze results
        all_response_times = []
        total_requests = 0
        
        for result in results:
            all_response_times.extend(result['response_times'])
            total_requests += result['request_count']
        
        if all_response_times:
            self.results['api_performance'] = {
                'total_requests': total_requests,
                'avg_response_time': statistics.mean(all_response_times),
                'p50_response_time': statistics.median(all_response_times),
                'p95_response_time': statistics.quantiles(all_response_times, n=20)[18],  # 95th percentile
                'p99_response_time': statistics.quantiles(all_response_times, n=100)[98], # 99th percentile
                'min_response_time': min(all_response_times),
                'max_response_time': max(all_response_times),
                'requests_per_second': total_requests / duration
            }
        
        return self.results['api_performance']
    
