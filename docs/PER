### WebSocket Performance Optimization

#### Connection Management
```python
# Optimized WebSocket connection handling
import asyncio
from collections import defaultdict
import weakref

class OptimizedWebSocketManager:
    def __init__(self, max_connections: int = 5000):
        self.max_connections = max_connections
        self.active_connections = weakref.WeakSet()
        self.connection_stats = defaultdict(int)
        self.message_queue = asyncio.Queue(maxsize=10000)
        self.batch_timer = None
        self.batch_size = 50
        
    async def handle_connection(self, websocket, path):
        """Optimized connection handling"""
        if len(self.active_connections) >= self.max_connections:
            await websocket.close(code=1008, reason="Server overload")
            return
        
        # Add to active connections
        self.active_connections.add(websocket)
        self.connection_stats["total_connections"] += 1
        
        try:
            # Process messages with batching
            async for message in websocket:
                await self.message_queue.put((websocket, message))
                
                # Start batch processing if not already running
                if not self.batch_timer:
                    self.batch_timer = asyncio.create_task(self.process_message_batch())
                    
        except Exception as e:
            logger.error(f"WebSocket error: {e}")
        finally:
            self.active_connections.discard(websocket)
    
    async def process_message_batch(self):
        """Process messages in batches for efficiency"""
        batch = []
        timeout = 0.1  # 100ms timeout
        
        try:
            while True:
                try:
                    # Get message with timeout
                    message = await asyncio.wait_for(
                        self.message_queue.get(), 
                        timeout=timeout
                    )
                    batch.append(message)
                    
                    # Process batch if full
                    if len(batch) >= self.batch_size:
                        await self.process_batch(batch)
                        batch.clear()
                        
                except asyncio.TimeoutError:
                    # Timeout - process remaining messages
                    if batch:
                        await self.process_batch(batch)
                        batch.clear()
                    break
                    
        finally:
            self.batch_timer = None
    
    async def process_batch(self, batch: List):
        """Process a batch of messages efficiently"""
        # Group messages by type for optimized processing
        message_groups = defaultdict(list)
        for websocket, message in batch:
            try:
                message_data = json.loads(message)
                message_type = message_data.get("type", "unknown")
                message_groups[message_type].append((websocket, message_data))
            except json.JSONDecodeError:
                await websocket.send(json.dumps({"error": "Invalid JSON"}))
        
        # Process each group
        for message_type, messages in message_groups.items():
            await self.process_message_group(message_type, messages)
