                connection_results['failed_connections'] += 1
                print(f"Session {session_id} failed: {e}")
        
        # Create concurrent connections
        tasks = [websocket_session(i) for i in range(concurrent_connections)]
        await asyncio.gather(*tasks, return_exceptions=True)
        
        # Analyze WebSocket results
        if connection_results['message_latencies']:
            self.results['websocket_performance'] = {
                'total_connections': concurrent_connections,
                'successful_connections': connection_results['successful_connections'],
                'failed_connections': connection_results['failed_connections'],
                'success_rate': connection_results['successful_connections'] / concurrent_connections * 100,
                'avg_connection_time': statistics.mean(connection_results['connection_times']),
                'avg_message_latency': statistics.mean(connection_results['message_latencies']),
                'p95_message_latency': statistics.quantiles(connection_results['message_latencies'], n=20)[18],
                'p99_message_latency': statistics.quantiles(connection_results['message_latencies'], n=100)[98]
            }
        
        return self.results['websocket_performance']
    
    def generate_performance_report(self) -> str:
        """Generate performance test report"""
        report = "Flex Living Performance Test Report\n"
        report += "=" * 40 + "\n\n"
        
        if 'api_performance' in self.results:
            api_results = self.results['api_performance']
            report += "API Performance:\n"
            report += f"  Total Requests: {api_results['total_requests']}\n"
            report += f"  Average Response Time: {api_results['avg_response_time']*1000:.2f}ms\n"
            report += f"  95th Percentile: {api_results['p95_response_time']*1000:.2f}ms\n"
            report += f"  99th Percentile: {api_results['p99_response_time']*1000:.2f}ms\n"
            report += f"  Requests/Second: {api_results['requests_per_second']:.2f}\n\n"
        
        if 'websocket_performance' in self.results:
            ws_results = self.results['websocket_performance']
            report += "WebSocket Performance:\n"
            report += f"  Total Connections: {ws_results['total_connections']}\n"
            report += f"  Success Rate: {ws_results['success_rate']:.2f}%\n"
            report += f"  Average Connection Time: {ws_results['avg_connection_time']*1000:.2f}ms\n"
            report += f"  Average Message Latency: {ws_results['avg_message_latency']*1000:.2f}ms\n"
            report += f"  95th Percentile Latency: {ws_results['p95_message_latency']*1000:.2f}ms\n"
            report += f"  99th Percentile Latency: {ws_results['p99_message_latency']*1000:.2f}ms\n\n"
        
        # Performance score
        score = self.calculate_performance_score()
        report += f"Overall Performance Score: {score}/100\n"
        
        if score >= 90:
            report += "Status: EXCELLENT ✅\n"
        elif score >= 80:
            report += "Status: GOOD ✅\n"
        elif score >= 70:
            report += "Status: ACCEPTABLE ⚠️\n"
        else:
            report += "Status: NEEDS IMPROVEMENT ❌\n"
        
        return report
    
    def calculate_performance_score(self) -> int:
        """Calculate overall performance score (0-100)"""
        score = 0
        
        if 'api_performance' in self.results:
            api_results = self.results['api_performance']
            
            # Response time score (40 points max)
            avg_response_time = api_results['avg_response_time'] * 1000
            if avg_response_time <= 50:
                score += 40
            elif avg_response_time <= 100:
                score += 30
            elif avg_response_time <= 200:
                score += 20
            else:
                score += 10
            
            # Throughput score (30 points max)
            rps = api_results['requests_per_second']
            if rps >= 1000:
                score += 30
            elif rps >= 500:
                score += 20
            elif rps >= 100:
                score += 10
            
            # Percentile score (30 points max)
            p95_time = api_results['p95_response_time'] * 1000
            if p95_time <= 100:
                score += 30
            elif p95_time <= 200:
                score += 20
            elif p95_time <= 500:
                score += 10
        
        if 'websocket_performance' in self.results:
            ws_results = self.results['websocket_performance']
            
            # WebSocket score (25 points max)
            success_rate = ws_results['success_rate']
            if success_rate >= 99:
                score += 25
            elif success_rate >= 95:
                score += 20
            elif success_rate >= 90:
                score += 15
            
            # Latency score (25 points max)
            avg_latency = ws_results['avg_message_latency'] * 1000
            if avg_latency <= 50:
                score += 25
            elif avg_latency <= 100:
                score += 20
            elif avg_latency <= 200:
                score += 15
        
        return min(score, 100)
