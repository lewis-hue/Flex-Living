### WebSocket Performance Optimization

#### Message Batching and Throttling
```typescript
// Optimized WebSocket message handling
class OptimizedWebSocketService {
  private messageQueue: WebSocketMessage[] = [];
  private batchTimer: NodeJS.Timeout | null = null;
  private readonly batchSize = 50;
  private readonly batchTimeout = 100; // 100ms
  
  // Throttled update mechanism
  private updateThrottles = new Map<string, NodeJS.Timeout>();
  
  // Batch send messages
  private sendBatch() {
    if (this.messageQueue.length === 0) return;
    
    const batch = this.messageQueue.splice(0, this.batchSize);
    const message = {
      type: 'batch_update',
      data: batch,
      timestamp: new Date().toISOString()
    };
    
    if (this.ws?.readyState === WebSocket.OPEN) {
      this.ws.send(JSON.stringify(message));
    }
    
    this.batchTimer = null;
  }
  
  // Queue message for batch processing
  queueMessage(message: WebSocketMessage) {
    this.messageQueue.push(message);
    
    if (this.messageQueue.length >= this.batchSize) {
      this.sendBatch();
    } else if (!this.batchTimer) {
      this.batchTimer = setTimeout(() => this.sendBatch(), this.batchTimeout);
    }
  }
  
  // Throttled updates for UI
  throttleUpdate(propertyId: string, update: PropertyUpdate) {
    // Clear existing throttle
    const existingThrottle = this.updateThrottles.get(propertyId);
    if (existingThrottle) {
      clearTimeout(existingThrottle);
    }
    
    // Set new throttle
    const newThrottle = setTimeout(() => {
      this.updateUI(propertyId, update);
      this.updateThrottles.delete(propertyId);
    }, 100); // 100ms throttle
    
    this.updateThrottles.set(propertyId, newThrottle);
  }
  
  private updateUI(propertyId: string, update: PropertyUpdate) {
    // Update UI with throttled update
    this.notifyListeners('property_update', { propertyId, update });
  }
}
